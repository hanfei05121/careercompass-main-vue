# ===========================================
# 测试环境（npm run build:test / npm run dev:test）
# ===========================================

VITE_APP_ENV=test

VITE_API_BASE_URL=https://test-api.careercompass.com
VITE_PROXY_TARGET=https://test-api.careercompass.com

# 测试环境必须连真实后端，禁止 mock
VITE_USE_MOCK=false
VITE_ENABLE_DEVTOOLS=true
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_LOG_LEVEL=info

VITE_AUTH_ENABLED=true
