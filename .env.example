# ===========================================
# 环境变量模板：复制为 .env.local 后按本机情况填写
# 优先级：.env.[mode].local > .env.[mode] > .env.local > .env
# ===========================================

VITE_APP_TITLE=CareerCompass
VITE_APP_CODE=careercompass
VITE_ROUTER_BASE=/

# 接口
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8080
VITE_API_TIMEOUT=15000
VITE_UPLOAD_URL=/api/upload

# 国际化：zh-CN | en-US
VITE_DEFAULT_LOCALE=zh-CN
VITE_I18N_FALLBACK_LOCALE=en-US

# 开关
VITE_USE_MOCK=true
VITE_ENABLE_DEVTOOLS=true
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_LOG_LEVEL=debug
VITE_AUTH_ENABLED=false

# 鉴权总开关
# 设为 true 启用 Firebase 登录鉴权；留空或 false 则完全关闭鉴权，所有页面直接放行
VITE_AUTH_ENABLED=false

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
