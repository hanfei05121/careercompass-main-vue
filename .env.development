# ===========================================
# 开发环境（npm run dev）
# ===========================================

VITE_APP_ENV=development

# 走本地代理，避免跨域
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8080

# 开发期默认启用 mock，后端未就绪也能跑通页面
VITE_USE_MOCK=true
VITE_ENABLE_DEVTOOLS=true
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_LOG_LEVEL=debug

# 开发期默认关闭鉴权，方便直接进页面
VITE_AUTH_ENABLED=false
